
                             ; CAMPER-LEAD: the camper, but before firing
                             ; it re-pings to see which way the target is
                             ; drifting across the beam and leads the shot
                             ; in that direction.

      15 TO A                ; corner coordinates
      15 TO B
      4 TO RANDOM            ; arc-phase jitter: reads give 0..3

  MOVE
      IF A # X GOSUB MOVEX   ; recalibrate SPEEDX while off-target
      TO N                   ; no-op else-branch
      IF B # Y GOSUB MOVEY
      IF A = X GOTO CAMP     ; arrived: start sniping
      GOTO MOVE

  MOVEX
      A - X TO SPEEDX
      ENDSUB

  MOVEY
      B - Y TO SPEEDY
      ENDSUB

  CAMP
      0 TO SPEEDX
      0 TO SPEEDY
      82 + RANDOM TO S       ; sweep bearing, ~82..185 degrees;
                             ; jittered phase so a distant stationary
                             ; target can't hide between rays forever

  SWEEP
      S + 3 TO S
      IF S > 185 GOTO RESET
      S TO RADAR
      RADAR TO R
      IF R < 0 GOTO CHECK
      GOTO SWEEP

  RESET
      82 + RANDOM TO S       ; re-jitter the arc phase
      IF A # X GOTO MOVE     ; bumped out of the corner? go back
      IF B # Y GOTO MOVE
      GOTO SWEEP

  CHECK
      S TO RADAR             ; re-ping the same bearing
      RADAR TO T
      IF T < 0 GOTO FIRE     ; still in the beam: fire straight
      S + 6 TO RADAR         ; drifted ahead of the sweep?
      RADAR TO T
      IF T < 0 GOTO LEAD
      S - 6 TO RADAR         ; or behind it?
      RADAR TO T
      IF T < 0 GOTO LAG
      GOTO SWEEP             ; lost it; resume the sweep

  FIRE
      S TO AIM
      0 - T TO SHOT
      GOTO SWEEP

  LEAD
      S + 12 TO AIM
      0 - T TO SHOT
      GOTO SWEEP

  LAG
      S - 12 TO AIM
      0 - T TO SHOT
      GOTO SWEEP
